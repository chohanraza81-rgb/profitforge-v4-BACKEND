# ============================================
# PROFITFORGE v4.0 – Environment Variables
# ============================================

# --------------------------------------------
# Environment & Server
# --------------------------------------------
NODE_ENV=production
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_characters
API_KEY=your_internal_api_key_for_clients

# --------------------------------------------
# Databases
# --------------------------------------------
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/profitforge
REDIS_URL=redis://:password@host:port

# --------------------------------------------
# Core APIs (REQUIRED – at least these must work)
# --------------------------------------------
SERPAPI_KEY=your_serpapi_key
AMAZON_SCRAPER_KEY=your_omkarcloud_amazon_scraper_key   # replaces RapidAPI for Amazon
APIFY_API_TOKEN=your_apify_token
SCRAPINGBEE_API_KEY=your_scrapingbee_key
GROQ_API_KEY=your_groq_key

# --------------------------------------------
# Optional E-commerce APIs (skip if not available)
# --------------------------------------------
SHOPIFY_API_KEY=your_shopify_key          # optional
GOOGLE_SHOPPING_API_KEY=your_google_shopping_key  # optional
EBAY_API_KEY=your_ebay_key                # optional
ETSY_API_KEY=your_etsy_key                # optional (pending approval)

# --------------------------------------------
# Cloudinary (for image hosting)
# --------------------------------------------
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# --------------------------------------------
# Email (Nodemailer)
# --------------------------------------------
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@profitforge.com

# --------------------------------------------
# Google Sheets OAuth (optional)
# --------------------------------------------
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/sheets/callback

# --------------------------------------------
# Notion (optional)
# --------------------------------------------
NOTION_API_KEY=your_notion_integration_key

# --------------------------------------------
# Resend (alternative email – optional)
# --------------------------------------------
RESEND_API_KEY=your_resend_key
