# Environment
NODE_ENV=production
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
API_KEY=your_api_key_for_clients

# Databases
MONGODB_URI=mongodb://localhost:27017/profitforge
REDIS_URL=redis://localhost:6379

# APIs
SERPAPI_KEY=your_serpapi_key
RAPIDAPI_KEY=your_rapidapi_key
APIFY_API_TOKEN=your_apify_token
SCRAPINGBEE_API_KEY=your_scrapingbee_key
GROQ_API_KEY=your_groq_key
SHOPIFY_API_KEY=your_shopify_key
GOOGLE_SHOPPING_API_KEY=your_google_shopping_key
EBAY_API_KEY=your_ebay_key
ETSY_API_KEY=your_etsy_key

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret

# Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password
EMAIL_FROM=noreply@profitforge.com

# Google Sheets OAuth
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/v1/sheets/callback

# Notion
NOTION_API_KEY=your_notion_integration_key

# Optional: Resend (instead of Nodemailer)
RESEND_API_KEY=your_resend_key
